# Riot Developer API key — get one at https://developer.riotgames.com/
# Dev keys expire every 24h and have low rate limits (fine for testing, not for
# sustained large-scale collection). Never commit your real key.
RIOT_API_KEY=

# Platform to seed collection from (na1, euw1, eun1, kr, jp1, br1, la1, la2,
# oc1, tr1, ru, ph2, sg2, th2, tw2, vn2). The matching regional routing
# (americas/asia/europe) is derived automatically.
RIOT_PLATFORM=na1

# Postgres connection string, e.g. a free Supabase or Neon instance:
# postgresql://user:password@host:port/dbname
DATABASE_URL=

# Riot dev-key rate limits by default (requests per second / per 2 minutes).
# Tighten or loosen these if you're issued a Personal/Production key with
# different limits.
RIOT_RATE_LIMIT_PER_SECOND=20
RIOT_RATE_LIMIT_PER_TWO_MINUTES=100
